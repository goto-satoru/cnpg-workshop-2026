          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (wait_event_type) (cnp_pg_stat_activity_wait_events_count{namespace=\"$namespace\", pod=~\"$pod\"})",
          "legendFormat": "{{wait_event_type}}",
